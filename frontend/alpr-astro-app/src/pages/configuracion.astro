---
import SidebarLayout from '../components/SidebarLayout.jsx';
import '../styles/global.css';  
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ALPR - Configuración</title>
  </head>
  <body class="bg-slate-900 text-slate-100">
    <SidebarLayout currentPath="/configuracion" client:load>
      <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-white">Ajustes del Sistema</h2>
        <p class="text-sm text-slate-400">Parámetros de conexión con la API Laravel y periféricos.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800">
          <h3 class="text-base font-bold text-white mb-4">Servidor API Backend</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">URL Endpoint</label>
              <input type="text" value="http://localhost:8000/api/plates" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-200 outline-none focus:border-blue-500"  />
            </div>
          </div>
        </div>
      </div>
    </SidebarLayout>
  </body>
</html>