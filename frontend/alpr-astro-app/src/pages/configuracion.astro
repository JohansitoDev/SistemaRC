---
import SidebarLayout from '../components/SidebarLayout.jsx';
import '../styles/global.css';  
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ALPR - Configuración</title>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <SidebarLayout currentPath="/configuracion" initialSettingsOpen={true} client:load>
      <div class="flex min-h-[70vh] items-center justify-center text-center">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Configuración</h2>
          <p class="mt-2 text-sm text-slate-500">Abre configuración desde el menú lateral.</p>
        </div>
      </div>
    </SidebarLayout>
  </body>
</html>